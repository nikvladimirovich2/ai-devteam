# =====================================================================
#  AI DevTeam — ADVANCED configuration. Everything here is optional:
#  the AI model, the key and GitHub/GitLab are normally set up in the browser
#  (⚙ Setup). A value set here wins over the browser settings.
#  Only INTERNAL_SECRET is required (the installers create it).
#     docker compose up -d && ./scripts/check.sh
#  The file holds secrets: chmod 600 .env
# =====================================================================

# Prebuilt image (default) or your own build (docker-compose.build.yml)
# DEVTEAM_IMAGE=ghcr.io/nikvladimirovich2/ai-devteam:latest
# Folder with company CA certificates (*.crt), mounted into every container
# CERTS_DIR=./agent/certs

# ---------- Corporate LLM (via LiteLLM, which is built into CrewAI) ----------
# LLM_MODEL uses the LiteLLM format "<provider>/<model>", for example:
#   ollama/qwen2.5-coder:32b          (Ollama,  LLM_BASE_URL=http://host:11434)
#   hosted_vllm/Qwen2.5-Coder-32B     (vLLM,    LLM_BASE_URL=http://host:8000/v1)
#   openai/my-model                   (any OpenAI-compatible API, LLM_BASE_URL=https://host/v1)
#   gigachat/GigaChat-2-Max           (GigaChat)
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
# Max context per response (tokens), 0 = provider default
LLM_MAX_TOKENS=0
# Model context window, tokens. 0 = auto (vLLM /v1/models max_model_len)
LLM_CONTEXT_WINDOW=0
# Timeout of one request to the model, seconds (LiteLLM / the native client)
LLM_TIMEOUT=600
# 1 = skip TLS certificate checks (self-signed corporate certificate)
LLM_SSL_VERIFY_DISABLE=0
# Native tool calling: auto (on for self-hosted LiteLLM providers) | 1 | 0.
# vLLM must run with --enable-auto-tool-choice --tool-call-parser <hermes for Qwen>.
LLM_FUNCTION_CALLING=auto

# Optional: a separate model for a specific role (empty = LLM_MODEL). Advice: MODELS.md
LEAD_MODEL=
ARCHITECT_MODEL=
BACKEND_MODEL=
FRONTEND_MODEL=
QA_MODEL=
DEVOPS_MODEL=

# ---------- API keys ----------
# Simplest: one key for the whole team
LLM_API_KEY=
# Or a personal key per agent (wins over LLM_API_KEY for that role)
LEAD_API_KEY=
ARCHITECT_API_KEY=
BACKEND_API_KEY=
FRONTEND_API_KEY=
QA_API_KEY=
DEVOPS_API_KEY=

# ---------- Repository: corporate GitLab OR GitHub (used only by the DevOps agent) ----------
# The provider is chosen by the URL: a host containing "github" -> GitHub, anything else -> GitLab.
#   GitLab (self-hosted/gitlab.com): https://gitlab.corp.local
#   GitHub.com:                      https://github.com
#   GitHub Enterprise Server:        https://github.corp.local   (API: <url>/api/v3)
GIT_URL=
# Force the provider (gitlab|github) if the URL does not show it. Empty = auto-detect.
GIT_PROVIDER=
# GitLab: Personal/Group Access Token, scopes api + write_repository
# GitHub: fine-grained PAT, Repository access = All repositories,
#         permissions Administration RW + Contents RW + Workflows RW + Actions R (Metadata R is automatic);
#         or classic PAT with scopes repo + workflow
GIT_TOKEN=
# GitLab: group/subgroup for new projects (e.g. ai-team/products); empty = the token owner's personal namespace
# GitHub: organization; empty = the token owner's personal account
GIT_NAMESPACE=
GIT_DEFAULT_BRANCH=main
# private | internal | public
GIT_VISIBILITY=private
# 1 = skip TLS certificate checks
GIT_SSL_VERIFY_DISABLE=0

GIT_AUTHOR_NAME=AI DevTeam
GIT_AUTHOR_EMAIL=ai-devteam@example.com

# ---------- Process ----------
# How many times QA can send work back for fixes
MAX_QA_ROUNDS=2
# CI: after the push the team waits for the pipeline; on failure DevOps gets the logs,
# fixes the cause and pushes again. How many fix rounds (0 = do not wait for CI)
MAX_CI_ROUNDS=3
# How long to wait for one pipeline, seconds (incl. queueing for a runner)
CI_WAIT_TIMEOUT=1200
CI_POLL_INTERVAL=15
# Max agent iterations (thought -> tool -> observation) per task
AGENT_MAX_ITER=40
# Timeout of one shell command of an agent, seconds: then it is killed with all its child processes
# and the agent gets a clear TIMEOUT error
SHELL_TIMEOUT=300
# Total time of one task run (a new task or a revision), minutes: then the team is stopped.
# Empty = 180 (also settable in ⚙ Setup → Limits; .env wins), 0 = no limit
TASK_TIME_LIMIT_MIN=
# Budget of one task run (a new task or a revision): when it is used up, the lead stops the team and writes
# a final message with the repository link. Empty = no limit (also settable in ⚙ Setup → Limits; .env wins).
# USD prices come from LiteLLM's table; local / unknown models count as $0, their tokens still count.
TASK_BUDGET_USD=
TASK_BUDGET_TOKENS=

# ---------- Notifications when a task run ends (optional; also in ⚙ Setup → Notifications) ----------
# Telegram: a bot from @BotFather + your chat id (@userinfobot) or a group id; write /start to the bot first
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
# Any URL that accepts POST with JSON (Slack / Mattermost incoming webhook, n8n, your own service)
NOTIFY_WEBHOOK_URL=

# ---------- Web interface ----------
# Listens only on 127.0.0.1 -> open it through an SSH tunnel
UI_BIND=127.0.0.1
UI_PORT=8080
# Optional Basic Auth for the UI (empty = no auth)
UI_USER=
UI_PASSWORD=

# ---------- Internal secret (required) ----------
# Signs requests between the containers, so that a command an agent runs cannot post events in
# another role's name or ask DevOps to publish. At least 32 characters:  openssl rand -hex 32
INTERNAL_SECRET=
